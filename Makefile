gingr.pro:
resource.qrc:
/opt/homebrew/lib/QtWidgets.framework/Resources/QtWidgets.prl:
/opt/homebrew/lib/QtGui.framework/Resources/QtGui.prl:
/opt/homebrew/lib/QtXml.framework/Resources/QtXml.prl:
